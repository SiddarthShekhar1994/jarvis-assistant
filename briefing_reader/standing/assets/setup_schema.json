{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JarvisStandingSetup",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "say"],
  "properties": {
    "kind": {"type": "string", "enum": ["agent", "rule", "neither"]},
    "say": {"type": "string", "maxLength": 300},
    "name": {"type": "string", "maxLength": 40},
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "account": {"type": "string", "maxLength": 24},
        "query": {"type": "string", "maxLength": 200},
        "question": {"type": "string", "maxLength": 200},
        "fields": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type"],
            "properties": {
              "name": {"type": "string", "maxLength": 20},
              "type": {"type": "string", "enum": ["text", "date", "datetime", "money", "number"]},
              "hint": {"type": "string", "maxLength": 80}
            }
          }
        },
        "action": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {"type": "string", "enum": ["todo", "event", "reply", "tell"]},
            "title": {"type": "string", "maxLength": 120},
            "due": {"type": "string", "maxLength": 20},
            "start": {"type": "string", "maxLength": 20},
            "minutes": {"type": "integer", "minimum": 15, "maximum": 480},
            "reply_hint": {"type": "string", "maxLength": 200}
          }
        },
        "tidy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {"type": "string", "enum": ["", "star", "label", "archive"]},
            "label_name": {"type": "string", "maxLength": 100}
          }
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trigger": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {"type": "string", "enum": ["time", "every", "mail", "manual"]},
            "times": {"type": "array", "maxItems": 4, "items": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"}},
            "weekdays": {"type": "array", "maxItems": 7, "items": {"type": "string", "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"]}},
            "every_minutes": {"type": "integer", "minimum": 30, "maximum": 10080}
          }
        },
        "mail": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["account", "query"],
            "properties": {
              "account": {"type": "string", "maxLength": 24},
              "query": {"type": "string", "maxLength": 200}
            }
          }
        },
        "calendar_days": {"type": "integer", "minimum": 0, "maximum": 14},
        "notes": {"type": "boolean"},
        "proposes": {"type": "array", "maxItems": 3, "items": {"type": "string", "enum": ["todo", "calendar", "reply"]}},
        "report": {"type": "string", "enum": ["every_run", "when_needed"]}
      }
    }
  }
}
