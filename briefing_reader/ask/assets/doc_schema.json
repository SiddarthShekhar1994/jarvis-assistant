{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JarvisDocument",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "say",
    "question",
    "doc",
    "sheet"
  ],
  "properties": {
    "say": {
      "type": "string",
      "maxLength": 200,
      "description": "Write this first. A few words for the owner: what you have lined up. No links, ids or addresses."
    },
    "question": {
      "type": "string",
      "maxLength": 200,
      "description": "One short question when the owner's words are unclear (else empty)."
    },
    "doc": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["title", "changes"],
      "description": "A document's changes (null for a sheet, or when you ask a question).",
      "properties": {
        "title": {"type": "string", "maxLength": 60},
        "changes": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "heading", "after", "text"],
            "properties": {
              "op": {"type": "string", "enum": ["add", "replace"]},
              "heading": {"type": "string", "maxLength": 200},
              "after": {"type": "string", "maxLength": 200},
              "text": {"type": "string", "maxLength": 8000}
            }
          }
        }
      }
    },
    "sheet": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["title", "columns", "add_rows", "set_cells"],
      "description": "A sheet's changes (null for a document, or when you ask a question).",
      "properties": {
        "title": {"type": "string", "maxLength": 60},
        "columns": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type", "choices"],
            "properties": {
              "name": {"type": "string", "maxLength": 40},
              "type": {"type": "string", "enum": ["text", "number", "date", "choice", "checkbox", "link"]},
              "choices": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 40}}
            }
          }
        },
        "add_rows": {
          "type": "array",
          "maxItems": 50,
          "items": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 500}}
        },
        "set_cells": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["row", "column", "value"],
            "properties": {
              "row": {"type": "string", "maxLength": 12},
              "column": {"type": "string", "maxLength": 40},
              "value": {"type": "string", "maxLength": 500}
            }
          }
        }
      }
    }
  }
}
