# Jarvis Assistant secrets and settings
#
# Copy this file to ".env" in the project folder (the folder that holds
# README.md and config.toml), then fill in both values. Never commit .env or
# share it: it holds your Notion integration secret. .gitignore already
# excludes it.

# Required. The "Internal Integration Secret" of your read-only Notion
# integration (README, setup step 2). Paste it right after the "=", on one line.
NOTION_TOKEN=

# Required. The Notion page the app reads (README, setup step 3). Open the page
# in Notion and copy its link (Share > Copy link, or the address bar). The id is
# the 32 letters and digits at the end of the link, after the page title:
#   https://www.notion.so/your-workspace/Daily-Briefing-0123456789abcdef0123456789abcdef?pvs=4
#   -> 0123456789abcdef0123456789abcdef
# The 32-character id, the dashed form (8-4-4-4-12) or the whole link all work.
# The id above is only an example. Without a valid id the app shows
# "Notion page ID missing." instead of reading anything.
BRIEFING_PAGE_ID=

# Optional (Ask Jarvis only). The claude.exe Ask runs, when the automatic search
# does not find it (README, "Ask Jarvis"). Leave it commented out otherwise.
# JARVIS_CLAUDE_EXE=C:\Users\you\.local\bin\claude.exe

# Turn Ask Jarvis on for this PC without editing the tracked config.toml
# (overrides [ask] enabled):
# JARVIS_ASK_ENABLED=true

# Turn web research (part of Ask Jarvis) off or on for this PC (overrides
# [research] enabled; README, "Web research"):
# JARVIS_RESEARCH_ENABLED=false

# Turn the productivity bundle (Memory: the MEMORY tab and "remember that ...")
# on for this PC; it also needs Ask Jarvis on (overrides [productivity] enabled;
# README, "Memory (the MEMORY tab)"):
# JARVIS_PRODUCTIVITY_ENABLED=true

# Turn meeting recording on for this PC (overrides [meetings] enabled; README,
# "Meetings: recording and summaries"). Jarvis still records only when you click
# Start on the start card:
# JARVIS_MEETINGS_ENABLED=true

# Turn Jarvis on your desktop on for this PC (overrides [desktop] enabled; see
# [desktop] in config.toml). Nothing works until you click Turn on on its card:
# JARVIS_DESKTOP_ENABLED=true

# Turn tasks on for this PC (overrides [agent] enabled; see [agent] in config.toml):
# Jarvis works a task through step by step. It also needs [desktop] and [ask] on:
# JARVIS_AGENT_ENABLED=true
